---
import Layout from '../components/layout/Layout.astro';
import Section from '../components/ui/Section.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import Accordion from '../components/ui/Accordion.astro';

const faqItems = [
  {
    title: "What is Project Kabir?",
    content: "Project Kabir is an initiative to document and showcase the rich cultural and historical heritage of Agra through interactive digital experiences. We aim to make history accessible, engaging, and educational for everyone.",
    isOpen: true
  },
  {
    title: "Is the mobile app free to download?",
    content: "Yes, the Project Kabir mobile app is completely free to download and use. Some premium features may require in-app purchases, but all core functionalities are available at no cost."
  },
  {
    title: "Do I need to create an account to use the map feature?",
    content: "While basic map browsing is available to all visitors, creating a free account allows you to save favorite monuments, create custom routes, and share your experiences with others."
  },
  {
    title: "How accurate is the historical information provided?",
    content: "All historical content on Project Kabir is thoroughly researched and verified by our team of historians and cultural experts. We strive for historical accuracy while making the content accessible and engaging."
  },
  {
    title: "Can I contribute content to Project Kabir?",
    content: "Yes! We welcome contributions from historians, researchers, and cultural enthusiasts. Please contact us through the form on this page to discuss potential collaboration opportunities."
  },
  {
    title: "Are there guided tours available through the app?",
    content: "Yes, our mobile app offers several curated audio tours for different historical sites in Agra. These guided experiences provide historical context, stories, and navigation assistance as you explore."
  }
];
---

<Layout title="Contact Us">
  <div class="contact-hero">
    <div class="hero-pattern"></div>
    <div class="container">
      <div class="contact-hero-content">
        <h1 class="fade-up">Get in Touch</h1>
        <p class="fade-up-delay">Have questions, feedback, or just want to say hello? We'd love to hear from you!</p>
      </div>
    </div>
  </div>

  <Section background="white" padding="large">
    <div class="contact-container">
      <div class="contact-info-column slide-in-left">
        <div class="contact-info-card">
          <h2>Contact Information</h2>
          <p class="contact-intro">Reach out to us through any of the following channels or fill out the contact form.</p>
          
          <div class="contact-details">
            <div class="contact-item hover-lift">
              <div class="contact-icon pulse">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="contact-text">
                <h4>Phone</h4>
                <p>+91 91763 96060</p>
              </div>
            </div>
            
            <div class="contact-item hover-lift">
              <div class="contact-icon pulse">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="contact-text">
                <h4>Email</h4>
                <p><a href="mailto:sagar@kabir-ai.com">sagar@kabir-ai.com</a></p>
              </div>
            </div>
            
            <div class="contact-item hover-lift">
              <div class="contact-icon pulse">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="contact-text">
                <h4>Address</h4>
                <p>ECHOSTORY EXPERIENCES PRIVATE LIMITED,<br>ATLF JMD EMPIRE SQUARE,<br>MR-01 3RD FLOOR SECTOR 28, DLF QE,<br>Gurgaon - 122002, Haryana</p>
              </div>
            </div>
            
            <div class="contact-item hover-lift">
              <div class="contact-icon pulse">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="contact-text">
                <h4>Working Hours</h4>
                <p>Monday - Friday: 9AM - 5PM<br>Saturday: 10AM - 2PM<br>Sunday: Closed</p>
              </div>
            </div>
          </div>
          
          <div class="social-links">
            <h3>Connect With Us</h3>
            <div class="social-icons">
              <a href="#" class="social-icon hover-pop" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
              <a href="#" class="social-icon hover-pop" aria-label="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                </svg>
              </a>
              <a href="#" class="social-icon hover-pop" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="#" class="social-icon hover-pop" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="contact-form-column slide-in-right">
        <div class="contact-form-card">
          <h2>Send Us a Message</h2>
          <p>Fill out the form below and we'll get back to you as soon as possible.</p>
          <ContactForm 
            withName={true}
            withPhone={true}
            withSubject={true}
            submitButtonText="Send Message"
          />
        </div>
      </div>
    </div>
  </Section>

  <Section background="light" padding="none">
    <div class="map-section">
      <div class="map-overlay"></div>
      <div class="map-embed">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56534.01793740066!2d78.00807985323963!3d27.176309242425727!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x397470941d266aa7%3A0x6e46c59cdb4eb144!2sAgra%2C%20Uttar%20Pradesh!5e0!3m2!1sen!2sin!4v1682518321114!5m2!1sen!2sin" 
          width="100%" 
          height="450" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </Section>

  <Section title="Frequently Asked Questions" background="white" centered={true} padding="large">
    <div class="faq-container fade-up">
      <Accordion 
        items={faqItems}
        variant="bordered"
        allowMultiple={false}
      />
    </div>
  </Section>
</Layout>

<style>
  .contact-hero {
    position: relative;
    background: linear-gradient(135deg, #c2634b 0%, #ad5541 100%);
    color: white;
    padding: 120px 0;
    text-align: center;
    overflow: hidden;
  }

  .hero-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 20%),
                      radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 20%);
    animation: patternFloat 20s linear infinite;
  }

  @keyframes patternFloat {
    0% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0); }
  }

  .contact-hero-content h1 {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .contact-hero-content p {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
    position: relative;
    z-index: 1;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .contact-info-card {
    background: linear-gradient(to bottom right, #ffffff, #fcf9f8);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    padding: 3rem;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .contact-form-card {
    background: linear-gradient(to bottom right, #ffffff, #fcf9f8);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    padding: 3rem;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .contact-info-card:hover, .contact-form-card:hover {
    transform: translateY(-5px);
  }

  .contact-info-card h2, .contact-form-card h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #333;
    font-size: 2rem;
    position: relative;
    display: inline-block;
  }

  .contact-info-card h2::after, .contact-form-card h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 50px;
    height: 3px;
    background-color: #c2634b;
    border-radius: 2px;
  }

  .contact-intro {
    margin-bottom: 2.5rem;
    color: #555;
    font-size: 1.1rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .contact-item:hover {
    background-color: rgba(194, 99, 75, 0.05);
  }

  .contact-icon {
    background: linear-gradient(135deg, rgba(194, 99, 75, 0.1), rgba(194, 99, 75, 0.2));
    width: 50px;
    height: 50px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #c2634b;
    transition: all 0.3s ease;
  }

  .contact-text {
    flex: 1;
  }

  .contact-text h4 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: #333;
  }

  .contact-text p {
    margin: 0;
    color: #555;
    line-height: 1.6;
  }

  .contact-text a {
    color: #c2634b;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
  }

  .contact-text a::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: -2px;
    left: 0;
    background-color: #c2634b;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .contact-text a:hover::after {
    transform: scaleX(1);
  }

  .social-links h3 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    color: #333;
  }

  .social-icons {
    display: flex;
    gap: 1.5rem;
  }

  .social-icon {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    background: linear-gradient(135deg, rgba(194, 99, 75, 0.1), rgba(194, 99, 75, 0.2));
    color: #c2634b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: #c2634b;
    color: white;
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 10px 20px rgba(194, 99, 75, 0.3);
  }

  .contact-form-card p {
    margin-bottom: 2rem;
    color: #555;
    font-size: 1.1rem;
  }

  .map-section {
    position: relative;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .map-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(194, 99, 75, 0.1), transparent);
    pointer-events: none;
  }

  .map-embed {
    width: 100%;
    height: 450px;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
  }

  .map-embed:hover {
    filter: grayscale(0%);
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.8s ease forwards;
  }

  .fade-up-delay {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.8s ease 0.2s forwards;
  }

  .slide-in-left {
    opacity: 0;
    transform: translateX(-50px);
    animation: slideInLeft 0.8s ease forwards;
  }

  .slide-in-right {
    opacity: 0;
    transform: translateX(50px);
    animation: slideInRight 0.8s ease forwards;
  }

  .pulse {
    animation: pulse 2s infinite;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    color: #333;
    font-size: 0.95rem;
  }

  .form-group input, .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid #e1e1e1;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: #c2634b;
    box-shadow: 0 0 0 3px rgba(194, 99, 75, 0.2);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    margin-top: 0.5rem;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.9rem;
    text-align: center;
    min-height: 1.5rem;
  }

  .status-sending {
    color: #3d5a80;
  }

  .status-success {
    color: #28a745;
  }

  .status-error {
    color: #dc3545;
  }

  @media (max-width: 992px) {
    .contact-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding: 80px 0;
    }

    .contact-hero-content h1 {
      font-size: 2.5rem;
    }
    
    .contact-info-card, .contact-form-card {
      padding: 2rem;
    }

    .contact-icon {
      width: 40px;
      height: 40px;
    }

    .social-icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .contact-hero-content h1 {
      font-size: 2rem;
    }

    .contact-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .social-icons {
      justify-content: space-between;
    }
  }
</style>