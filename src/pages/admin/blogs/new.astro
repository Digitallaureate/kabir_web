  @media (max-width: 768px) {
    .blog-create-container {
      padding: 1rem;
    }
    
    .admin-header {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
    
    .form-sidebar {
      grid-template-columns: 1fr;
    }
    
    .image-gallery {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
