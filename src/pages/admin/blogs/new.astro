---
import AdminLayout from '../../../components/layout/AdminLayout.astro';
import { getFirestore, collection, getDocs, query, orderBy } from "firebase/firestore";
import { app } from "../../../utils/firebase";
import { getBlogRequestDetail } from '../../../lib/traviz/client';
import { mapDraft, type FormDraft } from '../../../lib/traviz/mapDraft';

export const prerender = false;

// Initialize Firestore
const db = getFirestore(app);

// Fetch categories for the dropdown
const categoriesQuery = query(collection(db, "categories"), orderBy("name"));
const categoriesSnapshot = await getDocs(categoriesQuery);
const categories = categoriesSnapshot.docs.map(doc => ({
  id: doc.id,
  name: doc.data().name
}));

// When opened from the Requested Blog tab, the form is pre-filled with the
// draft the backend generated from the user's chat.
const requestId = Astro.url.searchParams.get('requestId');

let draft: FormDraft | null = null;
let requestedByName = '';
let chatId = '';
let userId = '';
let chatName = '';
let prefillError: string | null = null;

// Public origin for the blog URL sent back to the backend. Falls back to the
// request origin so this still works when running locally.
const siteOrigin = (Astro.site?.origin ?? new URL(Astro.request.url).origin).replace(/\/$/, '');

if (requestId) {
  try {
    const detail = await getBlogRequestDetail(requestId);

    if (!detail) {
      prefillError = `Request ${requestId} could not be loaded — start from a blank form.`;
    } else {
      requestedByName = detail.user_name || 'Unknown user';
      chatId = detail.chat_id;
      userId = detail.user_id;
      chatName = detail.chat_title || 'Untitled chat';

      if (detail.draft) {
        draft = mapDraft(detail.draft);
      } else {
        prefillError =
          detail.draft_error || 'No draft was generated for this request — start from a blank form.';
      }
    }
  } catch (error) {
    prefillError = error instanceof Error ? error.message : 'Could not prepare the draft.';
    console.error('Blog request prefill failed', error);
  }
}
---

<AdminLayout title="Create New Blog Post" activePage="blog">
  <div class="blog-create-container">
    <div class="admin-header">
      <div>
        <h1>Create New Blog Post</h1>
        <p class="header-subtitle">Create and publish a new blog post</p>
      </div>
      <div class="header-actions">
        <a href="/admin/blogs" class="admin-button admin-button-secondary">
          <span class="admin-button-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </span>
          Back to Blogs
        </a>
      </div>
    </div>
    
    <!-- Auto-save indicator -->
    <div class="auto-save-indicator" id="auto-save-indicator">
      <svg class="spinner" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" fill="none" stroke-width="3"/>
      </svg>
      <span id="save-status">Saving...</span>
    </div>
    
    {requestId && (draft || prefillError) && (
      <div class:list={['request-banner', { 'request-banner-error': prefillError }]}>
        {draft ? (
          <>
            <strong>Created from a Traviz request</strong> by {requestedByName} · chat {chatId}
            <span class="request-source">
              Draft generated from the chat — review and edit before publishing.
              {draft.mediaGallery.length > 0 && ` ${draft.mediaGallery.length} image${draft.mediaGallery.length === 1 ? '' : 's'} attached.`}
            </span>
          </>
        ) : (
          <>
            <strong>Could not prefill this request.</strong> {prefillError}
          </>
        )}
      </div>
    )}

    {draft && (
      <script
        type="application/json"
        id="prefill-data"
        set:html={JSON.stringify({
          blocks: draft.content.blocks,
          tags: draft.tags,
          heroImage: draft.heroImage,
          mediaGallery: draft.mediaGallery,
        })}
      />
    )}

    <form id="blog-form" class="blog-form">
      <input type="hidden" id="request-id" value={requestId ?? ''}>
      <input type="hidden" id="request-chat-id" value={chatId}>
      <input type="hidden" id="request-user-id" value={userId}>
      <input type="hidden" id="request-chat-name" value={chatName}>
      <input type="hidden" id="site-origin" value={siteOrigin}>
      <div class="form-main">
        <div class="admin-card">
          <div class="admin-card-header">
            <h2>Blog Content</h2>
            <div class="editor-toolbar-actions">
              <button type="button" class="editor-action-btn" id="toggle-fullscreen" title="Fullscreen">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="admin-card-body">
            <div class="admin-form-group">
              <label for="blog-title" class="admin-form-label">Title <span class="required">*</span></label>
              <input type="text" id="blog-title" class="admin-form-input" value={draft?.title ?? ''} required>
              <div class="char-count" id="title-count">{draft?.title.length ?? 0} / 100</div>
            </div>

            <div class="admin-form-group">
              <label for="blog-slug" class="admin-form-label">Slug <span class="required">*</span></label>
              <div class="input-with-button">
                <input type="text" id="blog-slug" class="admin-form-input" value={draft?.slug ?? ''} required>
                <button type="button" id="generate-slug" class="admin-button admin-button-sm">Generate</button>
              </div>
              <div class="form-helper">URL-friendly version of the title</div>
            </div>

            <div class="admin-form-group">
              <label for="blog-excerpt" class="admin-form-label">Excerpt <span class="required">*</span></label>
              <textarea id="blog-excerpt" class="admin-form-textarea" rows="3" required>{draft?.excerpt ?? ''}</textarea>
              <div class="char-count" id="excerpt-count">{draft?.excerpt.length ?? 0} / 200</div>
              <div class="form-helper">Short summary that appears in blog listings</div>
            </div>
            
            <div class="admin-form-group">
              <label class="admin-form-label">Hero Image</label>
              <div class="image-upload-container" id="hero-image-container">
                <div class="image-dropzone" id="hero-dropzone">
                  <div class="image-preview" id="hero-image-preview">
                    <div class="upload-placeholder">
                      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                      </svg>
                      <p>Drop image here or click to upload</p>
                      <span class="upload-hint">JPG, PNG or WebP, max 5MB</span>
                    </div>
                  </div>
                  <div class="upload-progress" id="hero-upload-progress">
                    <div class="progress-bar"></div>
                  </div>
                </div>
                <div class="upload-actions">
                  <label for="hero-image-upload" class="admin-button admin-button-secondary admin-button-sm">
                    <span class="admin-button-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                    </span>
                    Upload Image
                  </label>
                  <input type="file" id="hero-image-upload" class="hidden-file-input" accept="image/*">
                  <input type="hidden" id="hero-image-url">
                  <button type="button" id="remove-hero-image" class="admin-button admin-button-danger admin-button-sm" style="display: none;">
                    <span class="admin-button-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </span>
                    Remove
                  </button>
                </div>
              </div>
            </div>
            
            <div class="admin-form-group editor-group">
              <label for="blog-content" class="admin-form-label">Content <span class="required">*</span></label>
              <div class="editor-wrapper">
                <div id="blog-editor-container" class="blog-editor-container"></div>
                <textarea id="blog-content" class="hidden-textarea"></textarea>
              </div>
              <div class="editor-stats">
                <span class="word-count">0 words</span>
                <span class="char-count">0 characters</span>
                <span class="read-time">0 min read</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Additional Images Section -->
        <div class="admin-card additional-images-card">
          <div class="admin-card-header">
            <h3>Media Gallery</h3>
            <p class="header-subtitle">Upload and manage images for your blog post</p>
          </div>
          <div class="admin-card-body">
            <div class="gallery-dropzone" id="gallery-dropzone">
              <div class="dropzone-content">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p>Drop images here or click to upload</p>
                <span class="upload-hint">Upload multiple images at once</span>
              </div>
              <input type="file" id="additional-image-upload" class="hidden-file-input" accept="image/*" multiple>
            </div>
            
            <div class="image-gallery" id="image-gallery">
              <!-- Gallery images will be added dynamically -->
            </div>
          </div>
        </div>
      </div>
      
      <div class="form-sidebar">
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>Publication Settings</h3>
          </div>
          <div class="admin-card-body">
            <div class="admin-form-group">
              <label for="blog-author" class="admin-form-label">Author <span class="required">*</span></label>
              <input type="text" id="blog-author" class="admin-form-input" value={draft?.author ?? ''} required>
            </div>
            
            <div class="admin-form-group">
              <label for="blog-category" class="admin-form-label">Category <span class="required">*</span></label>
              <select id="blog-category" class="admin-form-select" required>
                <option value="">Select a category</option>
                {categories.map((category) => (
                  <option value={category.id}>{category.name}</option>
                ))}
              </select>
            </div>
            
            <div class="admin-form-group">
              <label for="blog-tags" class="admin-form-label">Tags</label>
              <div class="tags-input-container">
                <div class="tags-display" id="tags-display"></div>
                <input type="text" id="blog-tags" class="admin-form-input" placeholder="Type and press Enter">
              </div>
              <div class="form-helper">Press Enter to add tags</div>
            </div>
            
            <div class="admin-form-group checkbox-group">
              <label class="checkbox-wrapper">
                <input type="checkbox" id="blog-featured" class="admin-form-checkbox" checked={draft?.featured ?? false}>
                <span class="checkbox-label">Feature this post</span>
              </label>
            </div>
            
            <div class="admin-form-group">
              <label for="blog-status" class="admin-form-label">Status</label>
              <select id="blog-status" class="admin-form-select" required>
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </div>
          </div>
        </div>
        
        <div class="admin-card">
          <div class="admin-card-header">
            <h3>SEO Settings</h3>
          </div>
          <div class="admin-card-body">
            <div class="admin-form-group">
              <label for="seo-title" class="admin-form-label">SEO Title</label>
              <input type="text" id="seo-title" class="admin-form-input" value={draft?.seo.title ?? ''}>
              <div class="char-count" id="seo-title-count">{draft?.seo.title.length ?? 0} / 60</div>
              <div class="form-helper">If left empty, the post title will be used</div>
            </div>
            
            <div class="admin-form-group">
              <label for="seo-description" class="admin-form-label">Meta Description</label>
              <textarea id="seo-description" class="admin-form-textarea" rows="3">{draft?.seo.description ?? ''}</textarea>
              <div class="char-count" id="seo-desc-count">{draft?.seo.description.length ?? 0} / 160</div>
              <div class="form-helper">If left empty, the post excerpt will be used</div>
            </div>

            <div class="admin-form-group">
              <label for="seo-keywords" class="admin-form-label">Keywords</label>
              <input type="text" id="seo-keywords" class="admin-form-input" value={draft?.seo.keywords.join(', ') ?? ''}>
              <div class="form-helper">Separate keywords with commas</div>
            </div>
          </div>
        </div>
        
        <div class="form-actions">
          <button type="button" id="save-draft-btn" class="admin-button admin-button-secondary">
            <span class="admin-button-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
            </span>
            Save Draft
          </button>
          <button type="submit" id="publish-btn" class="admin-button admin-button-primary">
            <span class="admin-button-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"></path>
                <path d="M12 6V12"></path>
                <path d="M16 12L12 12"></path>
              </svg>
            </span>
            Publish Post
          </button>
        </div>
      </div>
    </form>
  </div>
  
  <!-- Image URL Copy Notification -->
  <div class="notification" id="url-notification">
    <div class="notification-content">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>Image URL copied to clipboard!</span>
    </div>
  </div>
</AdminLayout>

<style>
  :root {
    --primary-color: #c2634b;
    --primary-dark: #ad5541;
    --primary-light: #e08676;
    --secondary-color: #3d5a80;
    --success-color: #28a745;
    --warning-color: #ffc107;
    --danger-color: #dc3545;
    --text-color: #333333;
    --text-light: #666666;
    --border-color: #e1e1e1;
    --background-color: #f5f5f5;
    --card-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
  }
  
  .blog-create-container {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .request-banner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.5rem;
    border-radius: 6px;
    background: #eef4fb;
    border: 1px solid #c9dcf0;
    color: #24455f;
    font-size: 0.9rem;
  }

  .request-banner-error {
    background: #fdecea;
    border-color: #f5c6cb;
    color: #8b1a1a;
  }

  .request-source {
    color: var(--text-light);
    font-size: 0.82rem;
  }
  
  .blog-form {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2rem;
    margin-top: 2rem;
  }
  
  .form-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .form-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .hidden-textarea, 
  .hidden-file-input {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }
  
  /* Admin Card Styles */
  .admin-card {
    background: white;
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: var(--transition);
  }
  
  .admin-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }
  
  .admin-card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: #f9f9f9;
  }
  
  .admin-card-header h2,
  .admin-card-header h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-color);
  }
  
  .header-subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--text-light);
  }
  
  .admin-card-body {
    padding: 1.5rem;
  }
  
  /* Form Styles */
  .admin-form-group {
    margin-bottom: 1.5rem;
  }
  
  .admin-form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--text-color);
  }
  
  .required {
    color: var(--danger-color);
  }
  
  .admin-form-input,
  .admin-form-textarea,
  .admin-form-select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 0.95rem;
    transition: var(--transition);
    background-color: white;
  }
  
  .admin-form-input:focus,
  .admin-form-textarea:focus,
  .admin-form-select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(194, 99, 75, 0.15);
  }
  
  .admin-form-textarea {
    min-height: 100px;
    resize: vertical;
  }
  
  .form-helper {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-light);
  }
  
  .char-count {
    text-align: right;
    font-size: 0.75rem;
    color: var(--text-light);
    margin-top: 0.25rem;
  }
  
  .input-with-button {
    display: flex;
    gap: 0.5rem;
  }
  
  .input-with-button .admin-form-input {
    flex: 1;
  }
  
  /* Editor Styles */
  .editor-wrapper {
    position: relative;
  }
  
  .blog-editor-container {
    min-height: 500px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: white;
    transition: var(--transition);
  }
  
  .blog-editor-container:focus-within {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(194, 99, 75, 0.15);
  }
  
  .editor-toolbar-actions {
    display: flex;
    gap: 0.5rem;
  }
  
  .editor-action-btn {
    padding: 0.5rem;
    border: none;
    background: none;
    color: var(--text-light);
    cursor: pointer;
    border-radius: 4px;
    transition: var(--transition);
  }
  
  .editor-action-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--text-color);
  }
  
  .editor-stats {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding: 0.5rem;
    background-color: #f9f9f9;
    border-radius: 4px;
    font-size: 0.875rem;
    color: var(--text-light);
  }
  
  /* Image Upload Styles */
  .image-upload-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .image-dropzone {
    position: relative;
    cursor: pointer;
  }
  
  .image-preview {
    width: 100%;
    height: 250px;
    border: 2px dashed var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    transition: var(--transition);
  }
  
  .image-dropzone.dragover .image-preview {
    border-color: var(--primary-color);
    background-color: rgba(194, 99, 75, 0.05);
  }
  
  .image-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: var(--text-light);
  }
  
  .upload-placeholder svg {
    margin-bottom: 1rem;
    color: var(--primary-color);
  }
  
  .upload-placeholder p {
    margin: 0 0 0.5rem;
    font-weight: 500;
    color: var(--text-color);
  }
  
  .upload-hint {
    font-size: 0.875rem;
    color: var(--text-light);
  }
  
  .upload-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: rgba(0, 0, 0, 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .upload-progress.active {
    opacity: 1;
  }
  
  .progress-bar {
    height: 100%;
    background-color: var(--primary-color);
    width: 0;
    transition: width 0.3s ease;
  }
  
  .upload-actions {
    display: flex;
    gap: 0.5rem;
  }
  
  /* Gallery Styles */
  .gallery-dropzone {
    border: 2px dashed var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    margin-bottom: 1.5rem;
  }
  
  .gallery-dropzone:hover {
    border-color: var(--primary-color);
    background-color: rgba(194, 99, 75, 0.05);
  }
  
  .gallery-dropzone.dragover {
    border-color: var(--primary-color);
    background-color: rgba(194, 99, 75, 0.1);
  }
  
  .dropzone-content {
    color: var(--text-light);
  }
  
  .dropzone-content svg {
    margin-bottom: 1rem;
    color: var(--primary-color);
  }
  
  .dropzone-content p {
    margin: 0 0 0.5rem;
    font-weight: 500;
    color: var(--text-color);
