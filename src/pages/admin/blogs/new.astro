  }
  
  .admin-button-secondary:hover {
    background-color: #e0e0e0;
  }
  
  .admin-button-danger {
    background-color: var(--danger-color);
    color: white;
  }
  
  .admin-button-danger:hover {
    background-color: #bd2130;
  }
  
  .admin-button-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  
  .admin-button-icon {
    display: flex;
    align-items: center;
  }
  
  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    position: sticky;
    bottom: 1rem;
    background: white;
    padding: 1rem;
    border-radius: 8px;
    box-shadow: var(--card-shadow);
  }
  
  /* Auto-save Indicator */
  .auto-save-indicator {
    position: fixed;
    top: 1rem;
    right: 1rem;
    background: white;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    box-shadow: var(--card-shadow);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(-20px);
    transition: var(--transition);
    z-index: 100;
  }
  
  .auto-save-indicator.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .spinner {
    width: 16px;
    height: 16px;
    animation: spin 1s linear infinite;
  }
  
  .spinner circle {
    stroke: var(--primary-color);
    stroke-linecap: round;
    stroke-dasharray: 50;
    stroke-dashoffset: 12.5;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  /* Notification */
  .notification {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    background: var(--success-color);
    color: white;
    padding: 0.75rem 1rem;
