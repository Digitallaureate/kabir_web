---
import AdminLayout from '../../../components/layout/AdminLayout.astro';
import BlogPostsPanel from '../../../components/admin/BlogPostsPanel.astro';
import BlogCategoriesPanel from '../../../components/admin/BlogCategoriesPanel.astro';
import BlogRequestsPanel from '../../../components/admin/BlogRequestsPanel.astro';
import { getFirestore, collection, query, orderBy, getDocs } from "firebase/firestore";
import { app } from "../../../utils/firebase";
import { getBlogRequests } from '../../../lib/traviz/client';
import type { BlogRequest } from '../../../lib/traviz/types';

export const prerender = false;

// This page owns data fetching only. Each tab's markup, styles and behaviour
// live in its own component under components/admin/.
const db = getFirestore(app);

const blogsQuery = query(collection(db, "blogs"), orderBy("publishDate", "desc"));
const categoriesQuery = query(collection(db, "categories"), orderBy("name"));

const [blogsSnapshot, categoriesSnapshot] = await Promise.all([
  getDocs(blogsQuery),
  getDocs(categoriesQuery)
]);

const blogs = blogsSnapshot.docs.map(doc => ({
  id: doc.id,
  title: doc.data().title || "Untitled",
  excerpt: doc.data().excerpt || "",
  author: doc.data().author || "Unknown",
  category: doc.data().category || "",
  status: doc.data().status || "draft",
  featured: doc.data().featured || false,
  slug: doc.data().slug || "",
  publishDate: doc.data().publishDate?.toDate() || new Date()
}));

const categories = categoriesSnapshot.docs.map(doc => ({
  id: doc.id,
  name: doc.data().name || "Uncategorized",
  slug: doc.data().slug || "",
  description: doc.data().description || ""
}));

// Post counts per category, computed once instead of filtering inside the loop.
const postCountByCategory = blogs.reduce<Record<string, number>>((counts, blog) => {
  if (blog.category) {
    counts[blog.category] = (counts[blog.category] ?? 0) + 1;
  }
  return counts;
}, {});

// Blog requests raised in the Traviz app.
// Failing to reach Traviz must not take the whole Blog Management page down.
let blogRequests: BlogRequest[] = [];
let requestsError: string | null = null;

try {
  blogRequests = await getBlogRequests();
} catch (error) {
  requestsError = error instanceof Error ? error.message : 'Could not reach the Traviz backend';
  console.error('Failed to load blog requests', error);
}

const pendingRequestCount = blogRequests.filter(request => request.status === 'pending').length;
---

<AdminLayout title="Blog Management" activePage="blog">
  <div class="admin-container">
    <div class="admin-header">
      <div>
        <h1>Blog Management</h1>
        <p class="header-subtitle">Create, edit, and manage blog posts and categories</p>
      </div>
      <div class="header-actions">
        <a href="/admin/blogs/new" class="admin-button admin-button-primary">
          <span class="admin-button-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </span>
          New Blog Post
        </a>
      </div>
    </div>

    <!-- Blog Management Tabs -->
    <div class="admin-tabs">
      <button class="admin-tab active" data-tab="posts">Posts</button>
      <button class="admin-tab" data-tab="categories">Categories</button>
      <button class="admin-tab" data-tab="requested_blogs">
        Requested Blog
        {pendingRequestCount > 0 && <span class="tab-badge">{pendingRequestCount}</span>}
      </button>
    </div>

    <div class="tab-content active" id="posts-tab">
      <BlogPostsPanel blogs={blogs} categories={categories} />
    </div>

    <div class="tab-content" id="categories-tab">
      <BlogCategoriesPanel categories={categories} postCountByCategory={postCountByCategory} />
    </div>

    <div class="tab-content" id="requested_blogs-tab">
      <BlogRequestsPanel requests={blogRequests} loadError={requestsError} />
    </div>
  </div>
</AdminLayout>

<style>
  /* Tabs, cards, tables and modals all come from
     components/layout/styles/_admin.css. Only page chrome is styled here. */

  .admin-container {
    padding: 2rem;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .admin-header h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 600;
    color: #333;
  }

  .header-subtitle {
    margin: 0.5rem 0 0;
    color: #666;
    font-size: 0.95rem;
  }

  @media (max-width: 992px) {
    .admin-container {
      padding: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .admin-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.admin-tab');
    const tabContents = document.querySelectorAll('.tab-content');

    function activateTab(tabId: string | null) {
      const tabContentElement = tabId ? document.getElementById(`${tabId}-tab`) : null;
      if (!tabContentElement) return;

      tabs.forEach(t => t.classList.remove('active'));
      tabContents.forEach(c => c.classList.remove('active'));

      document.querySelector(`.admin-tab[data-tab="${tabId}"]`)?.classList.add('active');
      tabContentElement.classList.add('active');
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        activateTab(tabId);

        // Keep the URL in step so a reload stays on the same tab.
        const url = new URL(window.location.href);
        url.searchParams.set('tab', tabId ?? 'posts');
        window.history.replaceState({}, '', url);
      });
    });

    // Deep link support: /admin/blogs?tab=requested_blogs
    const requestedTab = new URLSearchParams(window.location.search).get('tab');
    if (requestedTab) {
      activateTab(requestedTab);
    }
  });
</script>
