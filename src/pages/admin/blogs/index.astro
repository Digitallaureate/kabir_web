  .admin-button-primary:hover {
    background-color: #ad5541;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(194, 99, 75, 0.2);
  }
  
  .admin-button-secondary {
    background-color: #f0f0f0;
    color: #333;
  }
  
  .admin-button-secondary:hover {
    background-color: #e0e0e0;
    transform: translateY(-2px);
  }
  
  .admin-button-danger {
    background-color: #dc3545;
    color: white;
  }
  
  .admin-button-danger:hover {
    background-color: #bd2130;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(220, 53, 69, 0.2);
  }
  
  .admin-button-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  
  .admin-button-icon {
    margin-right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Form styles */
  .admin-form-group {
    margin-bottom: 1.5rem;
  }
  
  .admin-form-label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: #333;
  }
  
  .admin-form-input,
  .admin-form-textarea,
  .admin-form-select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #e1e1e1;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    color: #333;
  }
  
  .admin-form-input:focus,
  .admin-form-textarea:focus,
  .admin-form-select:focus {
    outline: none;
    border-color: #c2634b;
    box-shadow: 0 0 0 3px rgba(194, 99, 75, 0.15);
  }
  
  .admin-form-textarea {
    min-height: 120px;
    resize: vertical;
  }
  
  .form-helper {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #666;
  }
  
  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    text-align: center;
  }
  
  .empty-icon {
    margin-bottom: 1.5rem;
    color: #ddd;
  }
  
  .empty-state h3 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    color: #333;
  }
  
  .empty-state p {
    margin: 0 0 1.5rem;
    color: #666;
    max-width: 300px;
  }
  
  /* Responsive styles */
  @media (max-width: 992px) {
    .admin-container {
      padding: 1.5rem;
    }
  }
  
  @media (max-width: 768px) {
    .admin-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .search-filter {
      flex-direction: column;
    }
    
    .search-box {
      width: 100%;
    }
    
    .filter-controls {
      width: 100%;
    }
    
    .filter-dropdown {
      flex-grow: 1;
    }
    
    .status-filter {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
      flex-wrap: nowrap;
    }
    
    .categories-grid {
      grid-template-columns: 1fr;
    }
    
    .modal-content {
      max-width: 90%;
    }
    
    .admin-button {
      width: 100%;
    }
  }
  
  @media (max-width: 576px) {
    .admin-button {
      width: 100%;
    }
  }
</style>

<script>
  import { getFirestore, collection, addDoc, doc, updateDoc, deleteDoc, serverTimestamp } from "firebase/firestore";
  import { app } from "../../../utils/firebase";  // Changed from utils/firebase to firebase
  
  // Initialize Firestore
  const db = getFirestore(app);
  
  document.addEventListener('DOMContentLoaded', function() {
    // Tab switching
    const tabs = document.querySelectorAll('.admin-tab');
    const tabContents = document.querySelectorAll('.tab-content');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));
        
        tab.classList.add('active');
        const tabContentElement = document.getElementById(`${tabId}-tab`);
        if (tabContentElement) {
          tabContentElement.classList.add('active');
        }
      });
    });
    
      // Status filter for blogs
      const filterButtons = document.querySelectorAll('.filter-btn');
      const blogRows = document.querySelectorAll('#blogs-table tbody tr');

      filterButtons.forEach(button => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-filter');

          filterButtons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');

          blogRows.forEach(row => {
            const htmlRow = row as HTMLElement;
            if (filter === 'all') {
              htmlRow.style.display = '';
            } else if (filter === 'featured') {
              htmlRow.style.display = htmlRow.getAttribute('data-featured') === 'true' ? '' : 'none';
            } else {
              htmlRow.style.display = htmlRow.getAttribute('data-status') === filter ? '' : 'none';
            }
          });
        });
      });

      // Category filter
      const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | HTMLInputElement | null;

  if (categoryFilter) {
    categoryFilter.addEventListener('change', () => {
      let selectedCategory: string;
      if (categoryFilter instanceof HTMLSelectElement) {
        selectedCategory = categoryFilter.value;
      } else if (categoryFilter instanceof HTMLInputElement) {
        selectedCategory = categoryFilter.value;
      } else {
        // Handle the case where categoryFilter is not a recognized input type
        console.error("Category filter element is not a recognized input type.");
        return;
      }

      const blogRows = document.querySelectorAll('[data-category]'); // Assuming your blog rows have a 'data-category' attribute

      blogRows.forEach(row => {
        const htmlRow = row as HTMLElement;
        if (selectedCategory === 'all') {
          htmlRow.style.display = '';
        } else {
          htmlRow.style.display = htmlRow.getAttribute('data-category') === selectedCategory ? '' : 'none';
      }
        });
    });
  } else {
  console.error("Category filter element with ID 'category-filter' not found.");
  }
    
    // Search functionality
    const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const searchTerm = searchInput.value.toLowerCase();
          const blogRows = document.querySelectorAll('[data-blog-row]'); // Adjust selector as needed

        blogRows.forEach(row => {
          const titleElement = row.querySelector('.post-title') as HTMLElement | null;
          const excerptElement = row.querySelector('.post-excerpt') as HTMLElement | null;
          const htmlRow = row as HTMLElement;

          if (titleElement && excerptElement) {
            const title = titleElement.textContent?.toLowerCase() || '';
            const excerpt = excerptElement.textContent?.toLowerCase() || '';
            if (title.includes(searchTerm) || excerpt.includes(searchTerm)) {
              htmlRow.style.display = '';
            } else {
              htmlRow.style.display = 'none';
            }
          }
        });
      });
    }
    
    // Category modal
    const categoryModal = document.getElementById('category-modal');
    const addCategoryBtn = document.getElementById('add-category-btn');
    const emptyAddCategoryBtn = document.getElementById('empty-add-category-btn');
    const cancelCategoryBtn = document.getElementById('cancel-category');
    const saveCategoryBtn = document.getElementById('save-category');
    const categoryForm = document.getElementById('category-form') as HTMLFormElement;
    const modalCloseButtons = document.querySelectorAll('.modal-close');
    
    // Auto-generate slug from name
    const categoryName = document.getElementById('category-name') as HTMLInputElement;
    const categorySlug = document.getElementById('category-slug') as HTMLInputElement;
    
    if (categoryName && categorySlug) {
      categoryName.addEventListener('input', () => {
        categorySlug.value = categoryName.value
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-');
      });
    }
    
    // Open category modal for adding
    const openCategoryModal = () => {
      const categoryModalTitle = document.getElementById('category-modal-title');
      const categoryId = document.getElementById('category-id') as HTMLInputElement;
      
      if (categoryModalTitle) {
        categoryModalTitle.textContent = 'Add Category';
      }
      
      if (categoryId) {
        categoryId.value = '';
      }
      
      if (categoryForm) {
        categoryForm.reset();
      }
      
      if (categoryModal) {
        categoryModal.classList.add('active');
      }
    };
    
    if (addCategoryBtn) {
      addCategoryBtn.addEventListener('click', openCategoryModal);
    }
    
    if (emptyAddCategoryBtn) {
      emptyAddCategoryBtn.addEventListener('click', openCategoryModal);
    }
    
    // Edit category
    const editCategoryBtns = document.querySelectorAll('.edit-category-btn');
    editCategoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const name = btn.getAttribute('data-name') || '';
        const slug = btn.getAttribute('data-slug') || '';
        const description = btn.getAttribute('data-description') || '';
        
        const categoryModalTitle = document.getElementById('category-modal-title');
        const categoryId = document.getElementById('category-id') as HTMLInputElement;
        const categoryNameInput = document.getElementById('category-name') as HTMLInputElement;
        const categorySlugInput = document.getElementById('category-slug') as HTMLInputElement;
        const categoryDescriptionInput = document.getElementById('category-description') as HTMLTextAreaElement;
        
        if (categoryModalTitle) {
          categoryModalTitle.textContent = 'Edit Category';
        }
        
        if (categoryId) {
          categoryId.value = id;
        }
        
        if (categoryNameInput) {
          categoryNameInput.value = name;
        }
        
        if (categorySlugInput) {
          categorySlugInput.value = slug;
        }
        
        if (categoryDescriptionInput) {
          categoryDescriptionInput.value = description;
        }
        
        if (categoryModal) {
          categoryModal.classList.add('active');
        }
      });
    });
    
    // Save category
    if (saveCategoryBtn) {
      saveCategoryBtn.addEventListener('click', async () => {
        const categoryIdInput = document.getElementById('category-id') as HTMLInputElement;
        const categoryNameInput = document.getElementById('category-name') as HTMLInputElement;
        const categorySlugInput = document.getElementById('category-slug') as HTMLInputElement;
        const categoryDescriptionInput = document.getElementById('category-description') as HTMLTextAreaElement;
        
        const id = categoryIdInput ? categoryIdInput.value : '';
        const name = categoryNameInput ? categoryNameInput.value : '';
        const slug = categorySlugInput ? categorySlugInput.value : '';
        const description = categoryDescriptionInput ? categoryDescriptionInput.value : '';
        
        if (!name || !slug) {
          alert('Name and slug are required');
          return;
        }
        
        try {
          const categoryData: {
            name: string;
            slug: string;
            description: string;
            updatedAt: any;
            createdAt?: any;
          } = {
            name,
            slug,
            description,
            updatedAt: serverTimestamp()
          };
          
          if (id) {
            // Update existing category
            await updateDoc(doc(db, "categories", id), categoryData);
          } else {
            // Add new category
            categoryData.createdAt = serverTimestamp();
            await addDoc(collection(db, "categories"), categoryData);
          }
          
          if (categoryModal) {
            categoryModal.classList.remove('active');
          }
          
          // Reload the page to show updated data
          window.location.reload();
        } catch (error) {
          console.error("Error saving category:", error);
          alert("Error saving category");
        }
      });
    }
    
    // Delete category
    const deleteCategoryBtns = document.querySelectorAll('.delete-category-btn');
    const deleteModal = document.getElementById('delete-modal');
    const deleteMessage = document.getElementById('delete-message');
    const deleteId = document.getElementById('delete-id') as HTMLInputElement;
    const deleteType = document.getElementById('delete-type') as HTMLInputElement;
    const confirmDeleteBtn = document.getElementById('confirm-delete');
    const cancelDeleteBtn = document.getElementById('cancel-delete');
    
    deleteCategoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const name = btn.getAttribute('data-name') || '';
        
        if (deleteMessage) {
          deleteMessage.textContent = `Are you sure you want to delete the category "${name}"?`;
        }
        
        if (deleteId) {
          deleteId.value = id;
        }
        
        if (deleteType) {
          deleteType.value = 'category';
        }
        
        if (deleteModal) {
          deleteModal.classList.add('active');
        }
      });
    });
    
    // Delete blog post
    const deleteBlogBtns = document.querySelectorAll('.delete-btn:not(.delete-category-btn)');
    
    deleteBlogBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || '';
        
        if (deleteMessage) {
          deleteMessage.textContent = `Are you sure you want to delete the blog post "${title}"?`;
        }
        
        if (deleteId) {
          deleteId.value = id;
        }
        
        if (deleteType) {
          deleteType.value = 'blog';
        }
        
        if (deleteModal) {
          deleteModal.classList.add('active');
        }
      });
    });
    
    // Confirm delete
    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener('click', async () => {
        const id = deleteId ? deleteId.value : '';
        const type = deleteType ? deleteType.value : '';
        
        try {
          if (type === 'category') {
            await deleteDoc(doc(db, "categories", id));
          } else if (type === 'blog') {
            await deleteDoc(doc(db, "blogs", id));
          }
          
          if (deleteModal) {
            deleteModal.classList.remove('active');
          }
          
          // Reload the page to show updated data
          window.location.reload();
        } catch (error) {
          console.error("Error deleting item:", error);
          alert("Error deleting item");
        }
      });
    }
    
    // Close modals
    if (cancelCategoryBtn) {
      cancelCategoryBtn.addEventListener('click', () => {
        if (categoryModal) {
          categoryModal.classList.remove('active');
        }
      });
    }
    
    if (cancelDeleteBtn) {
      cancelDeleteBtn.addEventListener('click', () => {
        if (deleteModal) {
          deleteModal.classList.remove('active');
        }
      });
    }
    
    modalCloseButtons.forEach(closeBtn => {
      closeBtn.addEventListener('click', () => {
        if (categoryModal) {
          categoryModal.classList.remove('active');
        }
        if (deleteModal) {
          deleteModal.classList.remove('active');
        }
      });
    });
    
    // Close modal when clicking outside
    window.addEventListener('click', (e) => {
      if (e.target === categoryModal) {
        if (categoryModal) {
          categoryModal.classList.remove('active');
        }
      }
      if (e.target === deleteModal) {
        if (deleteModal) {
          deleteModal.classList.remove('active');
        }
      }
    });
  });
</script>