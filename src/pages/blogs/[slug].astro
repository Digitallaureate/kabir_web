      padding: 0.75rem;
      margin: 1rem 0;
    }
    
    .embed-container {
      margin: 1rem 0;
    }
    
    .post-tags {
      margin-top: 1rem;
      padding-top: 1rem;
      gap: 0.4rem;
    }
    
    .post-tag {
      font-size: 0.8rem;
      padding: 0.3rem 0.8rem;
      min-height: 36px;
      min-width: 48px;
    }
    
    .sidebar-section {
      padding: 1rem;
      margin-bottom: 1rem;
    }
    
    .sidebar-title {
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }
    
    .related-post {
      gap: 0.5rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
    }
    
    .related-post-image {
      flex: 0 0 50px;
      height: 50px;
    }
    
    .related-post-content h4 {
      font-size: 0.9rem;
    }
    
    .related-post-content h4 a {
      min-height: 48px;
      line-height: 1.4;
    }
    
    .related-post-date {
      font-size: 0.7rem;
    }
    
    .blog-navigation {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .featured-badge {
      font-size: 0.85rem;
      padding: 0.5rem 0.75rem;
      min-height: 48px;
    }
  }
  
  @media (max-width: 576px) {
    .container {
      padding: 0 0.75rem;
    }
    
    .blog-hero {
      height: 250px;
    }
    
    .hero-content {
      padding-bottom: 1rem;
    }
    
    .blog-header {
      padding: 1rem 0 0.75rem;
    }
    
    .post-title {
      font-size: 1.5rem;
    }
    
    .post-meta {
      gap: 0.4rem;
    }
    
