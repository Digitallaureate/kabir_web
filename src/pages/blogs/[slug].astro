    }
    
    .post-author {
      font-size: 0.85rem;
    }
    
    .hero-content .post-author {
      color: rgba(255, 255, 255, 0.8);
    }
    
    .post-excerpt {
      font-size: 1rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
    }
    
    .post-content {
      font-size: 0.95rem;
      line-height: 1.6;
    }
    
    .post-content h2 {
      font-size: 1.25rem;
      margin: 1.25rem 0 0.4rem;
    }
    
    .post-content h3 {
      font-size: 1.1rem;
      margin: 1rem 0 0.4rem;
    }
    
    .post-content h4 {
