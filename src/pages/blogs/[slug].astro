    }
    
    .post-tag {
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
      min-height: 40px;
      min-width: 48px;
    }
    
    .sidebar-section {
      padding: 0.75rem;
      margin-bottom: 0.75rem;
    }
    
    .sidebar-title {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }
    
    .related-post {
      gap: 0.4rem;
      margin-bottom: 0.5rem;
      padding-bottom: 0.5rem;
    }
    
    .related-post-image {
      flex: 0 0 40px;
      height: 40px;
    }
    
    .related-post-content h4 {
      font-size: 0.85rem;
    }
    
