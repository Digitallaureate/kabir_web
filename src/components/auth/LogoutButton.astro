---
interface Props {
  class?: string;
  redirectTo?: string;
}

const { class: className = '', redirectTo = '/auth/login' } = Astro.props;
---

<button id="logoutBtn" class={`logout-btn ${className}`}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
    <polyline points="16 17 21 12 16 7"/>
    <line x1="21" y1="12" x2="9" y2="12"/>
  </svg>
  <span class="btn-text">Logout</span>
  <span class="btn-loading hidden">
    <svg class="spinner" width="16" height="16" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="32" stroke-dashoffset="32">
        <animate attributeName="stroke-dasharray" dur="2s" values="0 64;32 32;0 64" repeatCount="indefinite"/>
        <animate attributeName="stroke-dashoffset" dur="2s" values="0;-32;-64" repeatCount="indefinite"/>
      </circle>
    </svg>
  </span>
</button>

<style>
  .logout-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #dc3545, #e55a66);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .logout-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .logout-btn:hover::before {
    left: 100%;
  }

  .logout-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4);
  }

  .logout-btn:disabled {
    background: #6c757d;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-loading {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .spinner {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .hidden {
    display: none;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .logout-btn {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>

<script define:vars={{ redirectTo }}>
  document.addEventListener('DOMContentLoaded', async () => {
    // Dynamic import for client-side
    const { logoutUser } = await import('/src/lib/auth-client.ts');
        
        const logoutBtn = document.getElementById('logoutBtn');
        const btnText = logoutBtn.querySelector('.btn-text');
        const btnLoading = logoutBtn.querySelector('.btn-loading');
        
        logoutBtn?.addEventListener('click', async () => {
          try {
            logoutBtn.disabled = true;
            btnText.classList.add('hidden');
            btnLoading.classList.remove('hidden');
            
            await logoutUser();
            localStorage.removeItem('authUser');
            
            window.location.href = redirectTo;
          } catch (error) {
            console.error('Logout failed:', error);
            
            // Reset button state on error
            logoutBtn.disabled = false;
            btnText.classList.remove('hidden');
            btnLoading.classList.add('hidden');
          }
        });
  });
</script>