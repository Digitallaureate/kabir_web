---
// Blog requests queue, rendered as the "Requested Blog" tab on /admin/blogs.
//
// All client-side queries are scoped to this component's root element so the
// filter buttons and search box do not collide with the Posts tab on the same page.

import type { BlogRequest } from '../../lib/traviz/types';

interface Props {
  requests: BlogRequest[];
  loadError?: string | null;
}

const { requests, loadError = null } = Astro.props;

// Status filtering is not wired up yet — the list shows everything the backend
// returns. Only "requested" is emitted today; add filters once more statuses exist.
const statusLabels: Record<string, string> = {
  requested: 'Requested',
  in_progress: 'In Progress',
  completed: 'Completed',
  published: 'Published',
  rejected: 'Rejected',
};

/** Falls back to the raw backend value so a new status is visible, not hidden. */
const statusLabel = (status: string) => statusLabels[status] ?? status;

/** Status values that still need action from an admin. */
const isOpen = (status: string) => status === 'requested' || status === 'in_progress';

const formatDate = (value: string | null) => {
  if (!value) return '—';
  const parsed = new Date(value);
  return Number.isNaN(parsed.valueOf())
    ? '—'
    : parsed.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
};
---

<div class="blog-requests-panel" id="blog-requests-panel">
  

  {loadError && (
    <div class="error-banner">
      <strong>Could not load requests.</strong> {loadError}
    </div>
  )}

  <div class="admin-card">
    <div class="admin-card-header">
      <div class="status-filter">
        <button class="filter-btn active" data-request-filter="all">
          All <span class="count">{requests.length}</span>
        </button>
      </div>

      <div class="search-filter">
        <div class="search-box">
          <input type="text" id="request-search" placeholder="Search requests..." />
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>
    </div>

    <div class="table-container">
      <table class="admin-table" id="requests-table">
        <thead>
          <tr>
            <th>Topic</th>
            <th>Requested By</th>
            <th>Requested On</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {requests.map((request) => (
            <tr
              data-status={request.status}
              data-search={`${request.chat_title ?? ''} ${request.user_name ?? ''}`.toLowerCase()}
              class={request.status === 'rejected' ? 'inactive-row' : ''}
            >
              <td>
                <div class="topic-cell">
                  <span class="topic-text">{request.chat_title || 'Untitled chat'}</span>
                  <span class="chat-ref">chat {request.chat_id}</span>
                </div>
              </td>
              <td>{request.user_name || 'Unknown user'}</td>
              <td>{formatDate(request.created_at)}</td>
              <td>
                <span class={`status-badge status-${request.status}`}>
                  {statusLabel(request.status)}
                </span>
              </td>
              <td>
                <div class="action-buttons">
                  {isOpen(request.status) ? (
                    <>
                      <a
                        href={`/admin/blogs/new?requestId=${request.id}`}
                        class="admin-button admin-button-primary admin-button-sm"
                      >
                        Create Blog
                      </a>
                      <button
                        class="admin-button admin-button-secondary admin-button-sm reject-request-btn"
                        data-id={request.id}
                        data-topic={request.chat_title || 'Untitled chat'}
                      >
                        Reject
                      </button>
                    </>
                  ) : (
                    <span class="muted">{statusLabel(request.status)}</span>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {requests.length === 0 && !loadError && (
        <div class="empty-state">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
              <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
            </svg>
          </div>
          <h3>No blog requests yet</h3>
          <p>Requests raised by users in the Traviz app will appear here.</p>
        </div>
      )}
    </div>
  </div>

  <!-- Reject confirmation -->
  <div class="request-modal" id="reject-modal">
    <div class="request-modal-content">
      <h3>Reject this request?</h3>
      <p id="reject-topic" class="reject-topic"></p>
      <div class="admin-form-group">
        <label for="reject-reason" class="admin-form-label">Reason</label>
        <textarea id="reject-reason" class="admin-form-textarea" rows="3"
                  placeholder="Why is this request being rejected?"></textarea>
      </div>
      <div class="request-modal-actions">
        <button class="admin-button admin-button-secondary" id="cancel-reject">Cancel</button>
        <button class="admin-button admin-button-primary" id="confirm-reject">Reject Request</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Cards, tables, status pills, filter buttons, search box and the empty state
     all come from components/layout/styles/_admin.css. Only the pieces specific
     to this panel live here. */

  .error-banner {
    padding: 0.85rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    background: #fdecea;
    border: 1px solid #f5c6cb;
    color: #8b1a1a;
  }

  .topic-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .topic-text {
    font-weight: 500;
    color: #333;
  }

  .chat-ref {
    font-size: 0.75rem;
    color: #999;
    font-family: monospace;
  }

  .muted {
    color: #999;
    font-size: 0.875rem;
  }

  .request-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .request-modal.active {
    display: flex;
  }

  .request-modal-content {
    background: #fff;
    border-radius: 8px;
    padding: 1.5rem;
    width: min(480px, 92vw);
  }

  .request-modal-content h3 {
    margin: 0 0 0.5rem;
  }

  .reject-topic {
    color: #666;
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .request-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('blog-requests-panel');
    if (!panel) return;

    // Scoped to the panel so the Posts tab's own filter buttons are untouched.
    const rows = Array.from(panel.querySelectorAll<HTMLTableRowElement>('#requests-table tbody tr'));
    const filterButtons = Array.from(
      panel.querySelectorAll<HTMLButtonElement>('[data-request-filter]')
    );
    const searchInput = panel.querySelector('#request-search') as HTMLInputElement | null;

    let activeFilter = 'all';

    function applyFilters() {
      const term = searchInput?.value.trim().toLowerCase() ?? '';

      rows.forEach((row) => {
        const matchesStatus = activeFilter === 'all' || row.dataset.status === activeFilter;
        const matchesSearch = !term || (row.dataset.search ?? '').includes(term);
        row.style.display = matchesStatus && matchesSearch ? '' : 'none';
      });
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((other) => other.classList.remove('active'));
        button.classList.add('active');
        activeFilter = button.dataset.requestFilter ?? 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    // Reject flow
    const modal = panel.querySelector('#reject-modal');
    const topicLabel = panel.querySelector('#reject-topic');
    const reasonInput = panel.querySelector('#reject-reason') as HTMLTextAreaElement | null;
    const confirmButton = panel.querySelector('#confirm-reject') as HTMLButtonElement | null;
    const cancelButton = panel.querySelector('#cancel-reject');
    let pendingId: string | null = null;

    panel.querySelectorAll<HTMLButtonElement>('.reject-request-btn').forEach((button) => {
      button.addEventListener('click', () => {
        pendingId = button.dataset.id ?? null;
        if (topicLabel) topicLabel.textContent = button.dataset.topic ?? '';
        if (reasonInput) reasonInput.value = '';
        modal?.classList.add('active');
      });
    });

    cancelButton?.addEventListener('click', () => {
      pendingId = null;
      modal?.classList.remove('active');
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) {
        pendingId = null;
        modal.classList.remove('active');
      }
    });

    confirmButton?.addEventListener('click', async () => {
      if (!pendingId) return;

      confirmButton.disabled = true;
      confirmButton.textContent = 'Rejecting...';

      try {
        const response = await fetch('/api/traviz/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: pendingId, reason: reasonInput?.value ?? '' }),
        });

        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          throw new Error(body.error || 'Request failed');
        }

        window.location.reload();
      } catch (error) {
        alert(`Could not reject the request: ${error instanceof Error ? error.message : error}`);
        confirmButton.disabled = false;
        confirmButton.textContent = 'Reject Request';
      }
    });
  });
</script>
