---
// Blog posts table, rendered as the "Posts" tab on /admin/blogs.
//
// Astro scopes <style> to this component but NOT <script>, so every DOM query
// below is scoped to #blog-posts-panel. Its JS hooks use data-post-* / #post-*
// names so they cannot collide with the other tabs in the same document.

interface BlogSummary {
  id: string;
  title: string;
  excerpt: string;
  author: string;
  category: string;
  status: string;
  featured: boolean;
  slug: string;
  publishDate: Date;
}

interface CategorySummary {
  id: string;
  name: string;
}

interface Props {
  blogs: BlogSummary[];
  categories: CategorySummary[];
}

const { blogs, categories } = Astro.props;

const statusCounts = {
  all: blogs.length,
  published: blogs.filter((blog) => blog.status === 'published').length,
  draft: blogs.filter((blog) => blog.status === 'draft').length,
  featured: blogs.filter((blog) => blog.featured).length,
};
---

<div class="blog-posts-panel" id="blog-posts-panel">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="status-filter">
        <button class="filter-btn active" data-post-filter="all">
          All <span class="count">{statusCounts.all}</span>
        </button>
        <button class="filter-btn" data-post-filter="published">
          Published <span class="count">{statusCounts.published}</span>
        </button>
        <button class="filter-btn" data-post-filter="draft">
          Draft <span class="count">{statusCounts.draft}</span>
        </button>
        <button class="filter-btn" data-post-filter="featured">
          Featured <span class="count">{statusCounts.featured}</span>
        </button>
      </div>

      <div class="search-filter">
        <div class="search-box">
          <input type="text" id="post-search" placeholder="Search posts..." />
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <div class="filter-controls">
          <select class="filter-dropdown" id="post-category-filter">
            <option value="all">All Categories</option>
            {categories.map((category) => (
              <option value={category.id}>{category.name}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div class="table-container">
      <table class="admin-table" id="posts-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Author</th>
            <th>Date</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {blogs.map((blog) => (
            <tr
              class={blog.status === 'draft' ? 'inactive-row' : ''}
              data-status={blog.status}
              data-featured={blog.featured}
              data-category={blog.category}
              data-search={`${blog.title} ${blog.excerpt}`.toLowerCase().replace(/\s+/g, ' ').trim()}
            >
              <td>
                <div class="post-title-cell">
                  <span class="post-title">{blog.title}</span>
                  <span class="post-excerpt">{blog.excerpt?.substring(0, 100)}...</span>
                </div>
              </td>
              <td>
                <span class="category-badge">
                  {categories.find((c) => c.id === blog.category)?.name || 'Uncategorized'}
                </span>
              </td>
              <td>{blog.author}</td>
              <td>{blog.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
              <td>
                <span class={`status-badge ${blog.status === 'published' ? 'status-active' : 'status-inactive'}`}>
                  {blog.status === 'published' ? 'Published' : 'Draft'}
                </span>
              </td>
              <td>
                <span class={`featured-indicator ${blog.featured ? 'is-featured' : ''}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                </span>
              </td>
              <td>
                <div class="action-buttons">
                  <a href={`/admin/blogs/${blog.id}/edit`} class="action-btn edit-btn" title="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </a>
                  <a href={`/blogs/${blog.slug}`} target="_blank" class="action-btn view-btn" title="View">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </a>
                  <button class="action-btn delete-btn delete-post-btn" title="Delete" data-id={blog.id} data-title={blog.title}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {blogs.length === 0 && (
        <div class="empty-state">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
              <path d="M14 3v5h5M16 13H8M16 17H8M10 9H8"/>
            </svg>
          </div>
          <h3>No blog posts yet</h3>
          <p>Get started by creating your first blog post</p>
          <a href="/admin/blogs/new" class="admin-button admin-button-primary">
            Create New Post
          </a>
        </div>
      )}
    </div>

    {blogs.length > 0 && (
      <div class="table-pagination">
        <div class="pagination-info">Showing 1-{blogs.length} of {blogs.length} posts</div>
      </div>
    )}
  </div>

  <!-- Delete confirmation -->
  <div id="post-delete-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Delete Confirmation</h3>
        <button class="modal-close" data-close-post-delete>&times;</button>
      </div>
      <div class="modal-body">
        <p id="post-delete-message">Are you sure you want to delete this item?</p>
        <input type="hidden" id="post-delete-id">
      </div>
      <div class="modal-footer">
        <button class="admin-button admin-button-secondary" data-close-post-delete>Cancel</button>
        <button class="admin-button admin-button-danger" id="confirm-post-delete">Delete</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Cards, tables, filters, badges, modals and the empty state come from
     components/layout/styles/_admin.css. Only posts-specific styling is here. */

  .post-title-cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .post-title {
    font-weight: 500;
    color: #333;
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: #666;
  }
</style>

<script>
  import { getFirestore, doc, deleteDoc } from "firebase/firestore";
  import { app } from "../../utils/firebase";

  const db = getFirestore(app);

  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('blog-posts-panel');
    if (!panel) return;

    const rows = Array.from(panel.querySelectorAll<HTMLTableRowElement>('#posts-table tbody tr'));
    const filterButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-post-filter]'));
    const searchInput = panel.querySelector('#post-search') as HTMLInputElement | null;
    const categoryFilter = panel.querySelector('#post-category-filter') as HTMLSelectElement | null;

    let activeStatus = 'all';

    // One pass applies status, category and search together, so the three
    // controls compose instead of overwriting each other's row visibility.
    function applyFilters() {
      const term = searchInput?.value.trim().toLowerCase() ?? '';
      const selectedCategory = categoryFilter?.value ?? 'all';

      rows.forEach((row) => {
        const matchesStatus =
          activeStatus === 'all' ||
          (activeStatus === 'featured'
            ? row.dataset.featured === 'true'
            : row.dataset.status === activeStatus);
        const matchesCategory =
          selectedCategory === 'all' || row.dataset.category === selectedCategory;
        const matchesSearch = !term || (row.dataset.search ?? '').includes(term);

        row.style.display = matchesStatus && matchesCategory && matchesSearch ? '' : 'none';
      });
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((other) => other.classList.remove('active'));
        button.classList.add('active');
        activeStatus = button.dataset.postFilter ?? 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', applyFilters);
    categoryFilter?.addEventListener('change', applyFilters);

    // Delete flow
    const modal = panel.querySelector('#post-delete-modal');
    const message = panel.querySelector('#post-delete-message');
    const idField = panel.querySelector('#post-delete-id') as HTMLInputElement | null;
    const confirmButton = panel.querySelector('#confirm-post-delete') as HTMLButtonElement | null;

    const closeModal = () => modal?.classList.remove('active');

    panel.querySelectorAll<HTMLButtonElement>('.delete-post-btn').forEach((button) => {
      button.addEventListener('click', () => {
        if (message) {
          message.textContent = `Are you sure you want to delete the blog post "${button.dataset.title ?? ''}"?`;
        }
        if (idField) idField.value = button.dataset.id ?? '';
        modal?.classList.add('active');
      });
    });

    panel.querySelectorAll('[data-close-post-delete]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    confirmButton?.addEventListener('click', async () => {
      const id = idField?.value;
      if (!id) return;

      confirmButton.disabled = true;

      try {
        await deleteDoc(doc(db, "blogs", id));
        window.location.reload();
      } catch (error) {
        console.error("Error deleting blog post:", error);
        alert("Error deleting blog post");
        confirmButton.disabled = false;
      }
    });
  });
</script>
