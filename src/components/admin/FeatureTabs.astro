---
interface Props {
  activeTab?: string;
  onTabChange?: (tab: string) => void;
}

const { activeTab = "cities", onTabChange } = Astro.props;

const tabs = [
  { id: "cities", label: "Cities" },
  { id: "monuments", label: "Monuments" },
  { id: "submonuments", label: "Sub-monuments" },
  { id: "tours", label: "Tours" },
  { id: "extendedTours", label: "Extended Tours" },
  { id: "routes", label: "Routes" },
];
---

<div class="feature-tabs">
  {tabs.map((tab) => (
    <button
      class:list={["tab-btn", { active: activeTab === tab.id }]}
      data-collection={tab.id}
      onclick={`window.dispatchEvent(new CustomEvent('tabChange', { detail: '${tab.id}' }))`}
    >
      {tab.label}
    </button>
  ))}
</div>

<style>
  .feature-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tab-btn {
    padding: 0.8rem 1.2rem;
    background: #e2e8f0;
    border: 2px solid #4a5568;
    border-radius: 8px;
    color: #4a5568;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .tab-btn:hover,
  .tab-btn.active {
    background: #4a5568;
    color: #ffffff;
    border-color: #4a5568;
  }
</style>