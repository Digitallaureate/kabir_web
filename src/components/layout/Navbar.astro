---
// No auth logic needed - clean navigation only
---

<nav class="main-nav">
  <div class="nav-container">
    <div class="logo-container">
      <a href="/" class="logo-link">
        <span class="logo-text">Project <span class="highlight">Kabir</span></span>
      </a>
    </div>
    
    <ul class="nav-links">
      <li><a href="/" class="nav-link">Home</a></li>
      <li><a href="/about" class="nav-link">About</a></li>
      <li><a href="/map" class="nav-link">Explore History</a></li>
      <li><a href="/blogs" class="nav-link">Blog</a></li>
      <li><a href="/contact" class="nav-link">Contact</a></li>
    </ul>

    <button class="mobile-menu-btn" aria-label="Toggle menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
  
  <div class="mobile-menu">
    <div class="mobile-menu-header">
      <span class="mobile-logo">Project <span class="highlight">Kabir</span></span>
      <button class="mobile-close-btn" aria-label="Close menu">
        <span class="close-bar"></span>
        <span class="close-bar"></span>
      </button>
    </div>
    <ul class="mobile-nav-links">
      <li><a href="/" class="mobile-nav-link">Home</a></li>
      <li><a href="/about" class="mobile-nav-link">About</a></li>
      <li><a href="/map" class="mobile-nav-link">Explore History</a></li>
      <li><a href="/blogs" class="mobile-nav-link">Blog</a></li>
      <li><a href="/contact" class="mobile-nav-link">Contact</a></li>
    </ul>
  </div>
</nav>

<style>
  .main-nav {
    width: 100%;
    position: relative;
    z-index: 1000;
  }
  
  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 0;
  }
  
  .logo-container {
    flex-shrink: 0;
    z-index: 1002;
  }
  
  .logo-link {
    text-decoration: none;
    color: #333;
  }
  
  .logo-text {
    font-size: 28px;
    font-weight: 700;
    white-space: nowrap;
  }
  
  .highlight {
    color: #c2634b;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
    justify-content: center;
    align-items: center;
  }

  .nav-link {
    color: #333;
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    transition: all 0.3s ease;
    position: relative;
    padding: 0.75rem 0;
  }

  .nav-link:after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: #c2634b;
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: #c2634b;
  }

  .nav-link:hover:after {
    width: 100%;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1002;
    padding: 8px;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .mobile-menu-btn:hover {
    background-color: rgba(194, 99, 75, 0.1);
  }

  .bar {
    display: block;
    width: 25px;
    height: 3px;
    margin: 4px auto;
    background-color: #333;
    transition: all 0.3s ease;
    border-radius: 2px;
  }
  
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: white;
    z-index: 1001;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    border-bottom: 1px solid #f0f0f0;
    background: white;
    position: sticky;
    top: 0;
  }

  .mobile-logo {
    font-size: 24px;
    font-weight: 700;
    color: #333;
  }

  .mobile-close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .mobile-close-btn:hover {
    background-color: rgba(194, 99, 75, 0.1);
  }

  .close-bar {
    display: block;
    width: 25px;
    height: 3px;
    background-color: #333;
    border-radius: 2px;
    position: absolute;
  }

  .close-bar:nth-child(1) {
    transform: rotate(45deg);
  }

  .close-bar:nth-child(2) {
    transform: rotate(-45deg);
  }
  
  .mobile-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }
  
  .mobile-nav-link {
    display: block;
    padding: 1.25rem 2rem;
    color: #333;
    text-decoration: none;
    font-weight: 500;
    font-size: 18px;
    border-bottom: 1px solid #f0f0f0;
    transition: all 0.3s ease;
    position: relative;
  }
  
  .mobile-nav-link:hover {
    color: #c2634b;
    background-color: rgba(194, 99, 75, 0.05);
    padding-left: 2.5rem;
  }

  .mobile-nav-link:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: #c2634b;
    transition: width 0.3s ease;
  }

  .mobile-nav-link:hover:before {
    width: 4px;
  }
  
  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  
  .mobile-menu-btn.active .bar:nth-child(2) {
    opacity: 0;
  }
  
  .mobile-menu-btn.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  
  .mobile-menu.active {
    display: block;
    transform: translateX(0);
  }

  body.menu-open {
    overflow: hidden;
  }

  /* Responsive breakpoints */
  @media (max-width: 1024px) {
    .nav-links {
      gap: 1.5rem;
    }
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .logo-text {
      font-size: 24px;
    }

    .mobile-menu-header {
      padding: 1rem;
    }

    .mobile-nav-link {
      padding: 1rem;
      font-size: 16px;
    }

    .mobile-nav-link:hover {
      padding-left: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .logo-text {
      font-size: 20px;
    }

    .mobile-menu-header {
      padding: 0.75rem;
    }

    .mobile-logo {
      font-size: 20px;
    }
  }

  /* Smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
  }

  /* Focus states for accessibility */
  .nav-link:focus,
  .mobile-nav-link:focus,
  .mobile-menu-btn:focus,
  .mobile-close-btn:focus {
    outline: 2px solid #c2634b;
    outline-offset: 2px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileCloseBtn = document.querySelector('.mobile-close-btn');
    
    function toggleMenu() {
      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.classList.toggle('active');
        mobileMenu.classList.toggle('active');
        document.body.classList.toggle('menu-open');
      }
    }

    function closeMenu() {
      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.classList.remove('active');
        mobileMenu.classList.remove('active');
        document.body.classList.remove('menu-open');
      }
    }

    // Toggle menu on hamburger click
    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', toggleMenu);
    }

    // Close menu on close button click
    if (mobileCloseBtn) {
      mobileCloseBtn.addEventListener('click', closeMenu);
    }
    
    // Close menu when clicking on navigation links
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu && mobileMenu.classList.contains('active')) {
        closeMenu();
      }
    });

    // Close menu when clicking outside (on the overlay)
    if (mobileMenu) {
      mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
          closeMenu();
        }
      });
    }

    // Handle window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900 && mobileMenu && mobileMenu.classList.contains('active')) {
        closeMenu();
      }
    });
  });
</script>