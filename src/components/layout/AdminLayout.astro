---
import '/src/components/layout/styles/_admin.css';
import { onAuthStateChange } from 'src/lib/auth-client.ts';

interface Props {
  title: string;
  activePage?: 'dashboard' | 'blog' | 'contacts' | 'users' | 'settings';
}

const { title, activePage = 'dashboard' } = Astro.props;

// Everything blog-related lives under Blog Management, which has its own
// Posts / Categories / Requested Blog tabs.
const sidebarItems = [
  { name: 'Dashboard', icon: 'grid', href: '/admin', id: 'dashboard' },
  { name: 'Blog Management', icon: 'file-text', href: '/admin/blogs', id: 'blog' },
  { name: 'Contact Entries', icon: 'mail', href: '/admin/contacts', id: 'contacts' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Project Kabir Admin Dashboard" />
    <link rel="icon" type="image/svg+xml" href="/favicon-32x32.png" />
    <title>{title} - Project Kabir Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="admin-body">
    <div class="auth-loader" id="authLoader">
      <div class="loader-content">
        <div class="loader-icon">
          <svg width="80" height="80" viewBox="0 0 100 100">
            <path class="loader-path" d="M10,50 A40,40 0 1,1 90,50 A40,40 0 1,1 10,50 Z" />
            <path class="loader-monument" d="M50,10 L65,40 L80,90 H20 L35,40 Z" />
          </svg>
        </div>
        <div class="loader-text">Project Kabir</div>
      </div>
    </div>

    <div class="admin-layout">
      <div class="admin-mobile-header">
        <div class="mobile-logo">
          <span class="logo-text">Project <span class="highlight">Kabir</span></span>
        </div>
        <button class="mobile-menu-toggle" id="sidebar-toggle" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <aside class="admin-sidebar" id="admin-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-logo">
            <span class="logo-text">Project <span class="highlight">Kabir</span></span>
          </div>
          <button class="sidebar-close" id="sidebar-close" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        
        <nav class="sidebar-nav">
          <ul class="nav-items">
            {sidebarItems.map((item) => (
              <li class="nav-item">
                <a 
                  href={item.href} 
                  class:list={[
                    'nav-link', 
                    { active: activePage === item.id }
                  ]}
                  aria-current={activePage === item.id ? 'page' : undefined}
                >
                  <span class="nav-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {item.icon === 'grid' && (
                        <>
                          <rect x="3" y="3" width="7" height="7"></rect>
                          <rect x="14" y="3" width="7" height="7"></rect>
                          <rect x="14" y="14" width="7" height="7"></rect>
                          <rect x="3" y="14" width="7" height="7"></rect>
                        </>
                      )}
                      {item.icon === 'file-text' && (
                        <>
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                          <polyline points="14 2 14 8 20 8"></polyline>
                          <line x1="16" y1="13" x2="8" y2="13"></line>
                          <line x1="16" y1="17" x2="8" y2="17"></line>
                          <polyline points="10 9 9 9 8 9"></polyline>
                        </>
                      )}
                      {item.icon === 'mail' && (
                        <>
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                          <polyline points="22,6 12,13 2,6"></polyline>
                        </>
                      )}
                      {item.icon === 'users' && (
                        <>
                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                          <circle cx="9" cy="7" r="4"></circle>
                          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </>
                      )}
                      {item.icon === 'settings' && (
                        <>
                          <circle cx="12" cy="12" r="3"></circle>
                          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06-.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </>
                      )}
                    </svg>
                  </span>
                  <span class="nav-text">{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        
        <div class="sidebar-footer">
          <div class="user-info">
            <div class="user-avatar">
              <span>A</span>
            </div>
            <div class="user-details">
              <p class="user-name">Admin User</p>
              <p class="user-role">Administrator</p>
            </div>
          </div>
          
          <div class="action-buttons">
            <a href="/" class="action-button view-site" title="View Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <button class="action-button logout" title="Logout">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>
      </aside>
      
      <main class="admin-main">
        <slot />
      </main>
    </div>
    
    <style>
      .auth-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        transition: opacity 0.5s ease-out, visibility 0.5s ease-out;
      }

      .auth-loader.hidden {
        opacity: 0;
        visibility: hidden;
      }

      .loader-content {
        text-align: center;
      }

      .loader-path {
        fill: none;
        stroke: rgba(194, 99, 75, 0.2);
        stroke-width: 5;
      }

      .loader-monument {
        fill: #c2634b;
        transform-origin: center;
        animation: monument-pulse 1.5s ease-in-out infinite alternate;
      }

      .loader-text {
        font-size: 1.5rem;
        font-weight: 600;
        color: #c2634b;
        margin-top: 1rem;
        opacity: 0;
        animation: fade-in 1s ease-out 0.5s forwards;
      }

      @keyframes monument-pulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
      }

      @keyframes fade-in {
        0% { opacity: 0; }
        100% { opacity: 1; }
      }
    </style>

    <script>
      document.addEventListener('DOMContentLoaded', async () => {
        const { onAuthStateChange, logoutUser } = await import('src/lib/auth-client.ts');
        const authLoader = document.getElementById('authLoader')! as HTMLDivElement;
        
        if (authLoader) {
          authLoader.classList.remove('hidden');
        }

        const unsubscribe = onAuthStateChange((user) => {
          if (!user) {
            const redirectUrl = window.location.pathname + window.location.search;
            window.location.href = `/auth/login?redirect=${encodeURIComponent(redirectUrl)}`;
          } else {
            if (authLoader) {
              authLoader.classList.add('hidden');
            }
          }
        });

        const sidebarToggle = document.getElementById('sidebar-toggle')! as HTMLButtonElement;
        const sidebarClose = document.getElementById('sidebar-close')! as HTMLButtonElement;
        const sidebar = document.getElementById('admin-sidebar')! as HTMLElement;
        const logoutButton = document.querySelector('.action-button.logout')! as HTMLButtonElement;

        if (sidebarToggle && sidebar) {
          sidebarToggle.addEventListener('click', () => {
            sidebar.classList.add('active');
            document.body.classList.add('sidebar-open');
          });
        }
        
        if (sidebarClose && sidebar) {
          sidebarClose.addEventListener('click', () => {
            sidebar.classList.remove('active');
            document.body.classList.remove('sidebar-open');
          });
        }
        
        document.addEventListener('click', (event: Event) => {
          const target = event.target as Node;
          if (sidebar && sidebar.classList.contains('active') && 
              !sidebar.contains(target) && 
              target !== sidebarToggle) {
            sidebar.classList.remove('active');
            document.body.classList.remove('sidebar-open');
          }
        });

        // Add event listener for logout button
        if (logoutButton) {
          logoutButton.addEventListener('click', async () => {
            try {
              await logoutUser();
              // The onAuthStateChange callback will handle the redirect to /auth/login
            } catch (error: unknown) {
              const message = error instanceof Error ? error.message : 'Failed to logout';
              console.error(message);
              // Optionally, you can show an error message to the user
              alert(message);
            }
          });
        }

        window.addEventListener('beforeunload', () => {
          unsubscribe();
        });
      });
    </script>
  </body>
</html>