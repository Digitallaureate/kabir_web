---
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Explore the rich cultural heritage of Agra with Project Kabir' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <title>{title} | Project Kabir</title>
    <!-- Add Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <main>
      <slot />
    </main>
    
    <Footer />
  </body>
</html>

<style is:global>
  :root {
  --primary-color: #c2634b;
  --primary-dark: #ad5541;
  --primary-light: #e08676;
  --text-color: #333333;
  --text-light: #666666;
  --background-color: #ffffff;
  --background-alt: #f9f9f9;
  --accent-color: #3d5a80;
  --border-color: #e1e1e1;
  --success-color: #28a745;
  --warning-color: #ffc107;
  --error-color: #dc3545;
}

html {
  font-family: 'Poppins', sans-serif;
  scroll-behavior: smooth;
  /* Fix: Remove overflow-x hidden from html */
}

body {
  color: var(--text-color);
  line-height: 1.6;
  margin: 0;
  padding: 0;
  /* Fix: Remove overflow-x hidden and add proper box-sizing */
  box-sizing: border-box;
}

/* Fix: Add universal box-sizing */
*, *::before, *::after {
  box-sizing: border-box;
}

h1, h2, h3, h4, h5, h6 {
  margin-top: 0;
  line-height: 1.2;
  font-weight: 600;
}

h1 {
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
}

h2 {
  font-size: 2rem;
  margin-bottom: 1.25rem;
}

h3 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

p {
  margin: 0 0 1rem;
}

a {
  color: var(--primary-color);
  text-decoration: none;
  transition: color 0.3s ease;
}

a:hover {
  color: var(--primary-dark);
}

img {
  max-width: 100%;
  height: auto;
  /* Fix: Prevent images from causing overflow */
  display: block;
}

main {
  min-height: calc(100vh - 160px);
  /* Fix: Ensure main doesn't cause horizontal scroll */
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  /* Fix: Ensure container doesn't exceed viewport */
  box-sizing: border-box;
}

.section {
  padding: 80px 0;
  /* Fix: Prevent section from causing overflow */
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

.section-title {
  text-align: center;
  margin-bottom: 40px;
  position: relative;
}

.section-title:after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background-color: var(--primary-color);
  margin: 15px auto 0;
}

.btn {
  display: inline-block;
  padding: 10px 20px;
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 4px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
  /* Fix: Ensure buttons don't cause layout issues */
  box-sizing: border-box;
}

.btn:hover {
  background-color: var(--primary-dark);
  transform: translateY(-2px);
}

.btn-outline {
  background-color: transparent;
  border: 2px solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline:hover {
  background-color: var(--primary-color);
  color: white;
}

/* Fix: Add specific styles for mobile app download sections */
.mobile-app-section {
  background-color: var(--background-alt);
  padding: 60px 0;
  text-align: center;
  overflow: hidden; /* Contain any overflowing elements */
}

.mobile-app-section .container {
  position: relative;
  z-index: 1;
}

.app-download-buttons {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.app-download-buttons img {
  max-width: 150px;
  height: auto;
  border-radius: 8px;
  transition: transform 0.3s ease;
}

.app-download-buttons img:hover {
  transform: scale(1.05);
}

/* Utility classes */
.text-center {
  text-align: center;
}

.text-primary {
  color: var(--primary-color);
}

.mb-1 {
  margin-bottom: 0.5rem;
}

.mb-2 {
  margin-bottom: 1rem;
}

.mb-3 {
  margin-bottom: 1.5rem;
}

.mb-4 {
  margin-bottom: 2rem;
}

.mb-5 {
  margin-bottom: 3rem;
}

/* Fix: Add overflow prevention utilities */
.no-overflow {
  overflow: hidden;
}

.no-horizontal-scroll {
  overflow-x: hidden;
}

/* Responsive utilities */
@media (max-width: 768px) {
  .container {
    padding: 0 15px; /* Reduce padding on mobile */
  }
  
  .section {
    padding: 40px 0; /* Reduce section padding */
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    font-size: 1.75rem;
  }

  h3 {
    font-size: 1.25rem;
  }
  
  /* Fix: Ensure mobile app buttons stack properly */
  .app-download-buttons {
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }
  
  .app-download-buttons img {
    max-width: 200px;
  }
}

/* Fix: Additional viewport constraint */
@media (max-width: 480px) {
  .container {
    padding: 0 10px;
  }
  
  .section {
    padding: 30px 0;
  }
}
</style>