---
// Responsive grid layout component
interface Props {
  columns?: {
    mobile?: number;
    tablet?: number;
    desktop?: number;
  };
  gap?: string;
  classes?: string;
}

const {
  columns = { mobile: 1, tablet: 2, desktop: 3 },
  gap = '1.5rem',
  classes = ''
} = Astro.props;

const { mobile = 1, tablet = 2, desktop = 3 } = columns;
---

<div class:list={['grid-container', classes]} style={{ gap }}>
  <slot />
</div>

<style define:vars={{ 
  mobile: mobile, 
  tablet: tablet, 
  desktop: desktop,
  gap: gap
}}>
  .grid-container {
    display: grid;
    grid-template-columns: repeat(var(--mobile), 1fr);
    gap: var(--gap);
    width: 100%;
  }

  @media (min-width: 640px) {
    .grid-container {
      grid-template-columns: repeat(var(--tablet), 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-container {
      grid-template-columns: repeat(var(--desktop), 1fr);
    }
  }
</style>