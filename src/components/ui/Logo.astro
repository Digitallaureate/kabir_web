---
// You can replace this with an actual logo SVG or image later
---

<div class="logo">
    <a href="/" class="logo-link">
      <span class="logo-text">Project <span class="highlight">Kabir</span></span>
    </a>
  </div>
  
  <style>
    .logo {
      display: flex;
      align-items: center;
    }
  
    .logo-link {
      text-decoration: none;
      color: #333;
    }
  
    .logo-text {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
  
    .highlight {
      color: #c2634b;
    }
  
    @media (max-width: 768px) {
      .logo-text {
        font-size: 20px;
      }
    }
  </style>