---
// Testimonial component for displaying user quotes
interface Props {
  quote: string;
  author: string;
  role?: string;
  avatarUrl?: string;
  variant?: 'card' | 'minimal' | 'quote';
  classes?: string;
}

const { 
  quote, 
  author, 
  role, 
  avatarUrl,
  variant = 'card',
  classes = '' 
} = Astro.props;
---

<div class:list={['testimonial', `testimonial-${variant}`, classes]}>
  <div class="testimonial-quote-mark">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
      <path d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16.036-.33.084-.51.144-.09.030-.17.057-.25.083-.3.099-.57.207-.83.326.5.084.94.166.133.248.036.075.073.154.108.234.035.08.068.154.098.224.066.15.133.285.203.406.077.13.152.235.226.314.085.093.173.168.264.226.06.035.116.064.17.086.167.07.335.095.503.072.156-.022.3-.088.436-.197.136-.11.256-.262.358-.46.102-.195.156-.431.164-.706a1.106 1.106 0 0 0-.102-.472c-.066-.155-.172-.297-.32-.428a2.616 2.616 0 0 0-.564-.32c-.2-.08-.375-.133-.524-.16a4.332 4.332 0 0 0-.47-.05c-.166-.007-.33.003-.493.031a3.981 3.981 0 0 0-.481.102 2.99 2.99 0 0 0-.417.145c-.134.055-.27.143-.413.262a2.237 2.237 0 0 0-.386.398c-.226.292-.401.651-.525 1.077a4.383 4.383 0 0 0-.178 1.277c0 .37.058.8.173 1.289.116.489.307.969.573 1.44.266.471.586.875.96 1.212.373.337.788.56 1.241.671.363.08.728.107 1.095.081.365-.027.702-.11 1.01-.251.225-.097.419-.221.585-.371.165-.15.304-.335.416-.553a2.134 2.134 0 0 0 .94-1.934 1.794 1.794 0 0 0-.214-.784z"></path>
      <path d="M21.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16.036-.33.084-.51.144-.09.030-.17.057-.25.083-.3.099-.57.207-.83.326.5.084.94.166.133.248.036.075.073.154.108.234.035.08.068.154.098.224.066.15.133.285.203.406.077.13.152.235.226.314.085.093.173.168.264.226.06.035.116.064.17.086.167.07.335.095.503.072.156-.022.3-.088.436-.197.136-.11.256-.262.358-.46.102-.195.156-.431.164-.706a1.106 1.106 0 0 0-.102-.472c-.066-.155-.172-.297-.32-.428a2.616 2.616 0 0 0-.564-.32c-.2-.08-.375-.133-.524-.16a4.332 4.332 0 0 0-.47-.05c-.166-.007-.33.003-.493.031a3.981 3.981 0 0 0-.481.102 2.99 2.99 0 0 0-.417.145c-.134.055-.27.143-.413.262a2.237 2.237 0 0 0-.386.398c-.226.292-.401.651-.525 1.077a4.383 4.383 0 0 0-.178 1.277c0 .37.058.8.173 1.289.116.489.307.969.573 1.44.266.471.586.875.96 1.212.373.337.788.56 1.241.671.363.08.728.107 1.095.081.365-.027.702-.11 1.01-.251.225-.097.419-.221.585-.371.165-.15.304-.335.416-.553a2.134 2.134 0 0 0 .94-1.934 1.794 1.794 0 0 0-.214-.784z"></path>
    </svg>
  </div>
  
  <blockquote class="testimonial-content">
    <p>{quote}</p>
  </blockquote>
  
  <div class="testimonial-author">
    {avatarUrl && (
      <div class="author-avatar">
        <img src={avatarUrl} alt={author} loading="lazy" />
      </div>
    )}
    <div class="author-info">
      <div class="author-name">{author}</div>
      {role && <div class="author-role">{role}</div>}
    </div>
  </div>
</div>

<style>
  .testimonial {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .testimonial-quote-mark {
    color: rgba(194, 99, 75, 0.2);
    margin-bottom: 1rem;
  }

  .testimonial-content {
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }

  .testimonial-content p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #555;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-name {
    font-weight: 600;
    font-size: 1rem;
    color: #333;
  }

  .author-role {
    font-size: 0.875rem;
    color: #666;
  }

  /* Card variant */
  .testimonial-card {
    background-color: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
  }

  .testimonial-card .testimonial-quote-mark {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
  }

  /* Minimal variant */
  .testimonial-minimal {
    padding: 1rem 0;
  }

  .testimonial-minimal .testimonial-quote-mark {
    margin-bottom: 0.5rem;
  }

  .testimonial-minimal .testimonial-content p {
    font-size: 1rem;
  }

  /* Quote variant */
  .testimonial-quote {
    text-align: center;
  }

  .testimonial-quote .testimonial-quote-mark {
    margin: 0 auto 1rem;
  }

  .testimonial-quote .testimonial-content p {
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 500;
  }

  .testimonial-quote .testimonial-author {
    flex-direction: column;
    gap: 0.5rem;
  }

  .testimonial-quote .author-avatar {
    width: 70px;
    height: 70px;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .testimonial-content p {
      font-size: 1rem;
    }

    .testimonial-quote .testimonial-content p {
      font-size: 1.25rem;
    }

    .testimonial-card {
      padding: 1.5rem;
    }
  }
</style>